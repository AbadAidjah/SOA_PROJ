<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://pharmacie.com/demo"
           xmlns:tns="http://pharmacie.com/demo"
           elementFormDefault="qualified">

    <!-- Get Stock -->
    <xs:element name="getStockRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="drugCode" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    <xs:element name="getStockResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="quantityAvailable" type="xs:int"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- Reserve Medicines -->
    <xs:element name="reserveMedicinesRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="prescriptionId" type="xs:string"/>
                <xs:element name="items" minOccurs="1" maxOccurs="unbounded">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="drugCode" type="xs:string"/>
                            <xs:element name="qtyReserved" type="xs:int"/>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    <xs:element name="reserveMedicinesResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="reservationId" type="xs:string" minOccurs="0"/>
                <xs:element name="status" type="xs:string"/>
                <xs:element name="message" type="xs:string" minOccurs="0"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- Cancel Reservation -->
    <xs:element name="cancelReservationRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="reservationId" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    <xs:element name="cancelReservationResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="status" type="xs:string"/>
                <xs:element name="message" type="xs:string" minOccurs="0"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- Dispense Reservation -->
    <xs:element name="dispenseReservationRequest">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="reservationId" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>
    <xs:element name="dispenseReservationResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="status" type="xs:string"/>
                <xs:element name="message" type="xs:string" minOccurs="0"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>